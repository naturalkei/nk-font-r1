# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff format (pyproject.toml: line-length = 100)
[*.py]
indent_size = 4
max_line_length = 100

[{Makefile,*.mk}]
indent_style = tab

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{lock,txt}]
trim_trailing_whitespace = false
